{
 "laws": [
  {
   "id": "T1",
   "name": "assibilation",
   "text": "t becomes s before a front vowel or y",
   "stage": "Proto-Tū́glemća",
   "dates": "−9,000 to −6,000"
  },
  {
   "id": "T2",
   "name": "the syllabic resonants",
   "text": "ṛ ḷ ṃ ṇ become ar al am an; before a vowel they are consonants",
   "stage": "Proto-Tū́glemća",
   "dates": "−9,000 to −6,000"
  },
  {
   "id": "T3",
   "name": "the great shift",
   "text": "bʰ dʰ gʰ ǵʰ gʷʰ > b d g ǵ gʷ;  b d g ǵ gʷ > p t k ć kʷ;  p t k ḱ kʷ > f θ x ś xʷ, except after a consonant, where ḱ is ć",
   "stage": "Proto-Tū́glemća",
   "dates": "−9,000 to −6,000"
  },
  {
   "id": "T4",
   "name": "loss of the laryngeals",
   "text": "ḥ and ʔ are lost; a voiced stop before ḥ is first made voiceless",
   "stage": "Old Tū́glemća",
   "dates": "−6,000 to −3,500"
  },
  {
   "id": "T5",
   "name": "x becomes h",
   "text": "x > h and xʷ > hʷ before a vowel or a resonant",
   "stage": "Old Tū́glemća",
   "dates": "−6,000 to −3,500"
  },
  {
   "id": "T6",
   "name": "the dentals before s",
   "text": "a dental is lost before s",
   "stage": "Old Tū́glemća",
   "dates": "−6,000 to −3,500"
  },
  {
   "id": "T7",
   "name": "the labiovelars resolve",
   "text": "before a vowel kʷ gʷ hʷ become kw gw hw; elsewhere they lose their rounding",
   "stage": "Old Tū́glemća",
   "dates": "−6,000 to −3,500"
  },
  {
   "id": "R1",
   "name": "the voiced palatal",
   "text": "ǵ opens to y; Rákva keeps two palatals only, ć and ś",
   "stage": "Old Rákva",
   "dates": "−3,500 to −2,860"
  },
  {
   "id": "R2",
   "name": "the a-merger",
   "text": "short e and o fall together as a; long ē ō stand",
   "stage": "Old Rákva",
   "dates": "−3,500 to −2,860"
  },
  {
   "id": "R3",
   "name": "y before a long front vowel",
   "text": "y is lost between a consonant and ē or ī",
   "stage": "Old Rákva",
   "dates": "−3,500 to −2,860"
  },
  {
   "id": "R4",
   "name": "the offglides",
   "text": "y and w become i and u after a vowel when no vowel follows; w before y stands",
   "stage": "Old Rákva",
   "dates": "−3,500 to −2,860"
  },
  {
   "id": "R5",
   "name": "rhotacism",
   "text": "a final -s becomes -r after a long vowel",
   "stage": "Old Rákva",
   "dates": "−3,500 to −2,860"
  },
  {
   "id": "R6",
   "name": "contraction",
   "text": "two like vowels in hiatus contract to one long vowel",
   "stage": "Classical Rákva",
   "dates": "−2,860 to −2,400"
  },
  {
   "id": "R7",
   "name": "the labials before w",
   "text": "bw > v at the head of a word and between vowels, though after a consonant the b stands; pw- and fw- > f- at the head of a word; between vowels -pw- > -f-, -fw- > -v-",
   "stage": "Classical Rákva",
   "dates": "−2,860 to −2,400"
  },
  {
   "id": "R8",
   "name": "w becomes v",
   "text": "w > v before a vowel or y, after any consonant too; lost before u",
   "stage": "Classical Rákva",
   "dates": "−2,860 to −2,400"
  },
  {
   "id": "R9",
   "name": "final n",
   "text": "a word-final n is lost",
   "stage": "Classical Rákva",
   "dates": "−2,860 to −2,400"
  },
  {
   "id": "R10",
   "name": "the finals",
   "text": "final -ēy > -ī; a long vowel shortens in a closed final syllable",
   "stage": "Classical Rákva",
   "dates": "−2,860 to −2,400"
  }
 ],
